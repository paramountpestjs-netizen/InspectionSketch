<Window x:Class="InspectionSketch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:drawing="clr-namespace:InspectionSketch.Drawing"
        Title="Inspection Sketch"
        Width="1200"
        Height="800"
        Background="#202020"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <drawing:SketchCanvas x:Name="DrawingCanvas"
                          Grid.Column="0"
                          Background="White"
                          MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown" />

        <Border Grid.Column="1"
            Background="#F3F3F3"
            BorderBrush="#CCCCCC"
            BorderThickness="1,0,0,0"
            Padding="15">

            <StackPanel>

                <TextBlock Text="File"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="Black"
               Margin="0,0,0,8" />
                
                <Button x:Name="NewSketchButton"
            Content="New Sketch"
            Height="32"
            Margin="0,0,0,8"
            Click="NewSketchButton_Click" />
                
                <Button x:Name="SaveSketchButton"
            Content="Save Sketch"
            Height="32"
            Margin="0,0,0,8"
            Click="SaveSketchButton_Click" />
                
                <Button x:Name="SaveAsButton"
            Content="Save As"
            Height="32"
            Margin="0,0,0,8"
            Click="SaveAsButton_Click" />
                
                <Button x:Name="OpenSketchButton"
            Content="Open Sketch"
            Height="32"
            Margin="0,0,0,18"
            Click="OpenSketchButton_Click" />

                <TextBlock Text="History"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="Black"
               Margin="0,0,0,8" />

                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="UndoButton"
                Grid.Column="0"
                Content="Undo"
                Height="32"
                Click="UndoButton_Click" />

                    <Button x:Name="RedoButton"
                Grid.Column="2"
                Content="Redo"
                Height="32"
                Click="RedoButton_Click" />
                </Grid>

                <TextBlock Text="Selected Wall"
               FontSize="18"
               FontWeight="Bold"
               Foreground="Black"
               Margin="0,0,0,15" />

                <TextBlock Text="Length"
               Foreground="Black"
               FontWeight="SemiBold" />

                <TextBlock x:Name="SelectedWallLengthText"
               Text="No wall selected"
               Foreground="Black"
               FontSize="16"
               Margin="0,5,0,15" />

                <Button x:Name="EditWallLengthButton"
            Content="Edit Length"
            Height="32"
            IsEnabled="False"
            Click="EditWallLengthButton_Click" />

                <Button x:Name="DeleteWallButton"
            Content="Delete Wall"
            Height="32"
            Margin="0,10,0,0"
            IsEnabled="False"
            Click="DeleteWallButton_Click" />
               
                <TextBlock Text="Sketch Measurements"
           FontSize="18"
           FontWeight="Bold"
           Foreground="Black"
           Margin="0,24,0,15" />

                <TextBlock Text="Perimeter"
           Foreground="Black"
           FontWeight="SemiBold" />

                <TextBlock x:Name="PerimeterText"
           Text="0'-0&quot;"
           Foreground="Black"
           FontSize="16"
           Margin="0,5,0,0" />
                
                <TextBlock Text="Outline"
           Foreground="Black"
           FontWeight="SemiBold"
           Margin="0,15,0,0" />

                <TextBlock x:Name="OutlineStatusText"
           Text="Open"
           Foreground="Black"
           FontSize="16"
           Margin="0,5,0,0" />

                <TextBlock Text="Area"
           Foreground="Black"
           FontWeight="SemiBold"
           Margin="0,15,0,0" />

                <TextBlock x:Name="AreaText"
           Text="0 sq ft"
           Foreground="Black"
           FontSize="16"
           Margin="0,5,0,0" />

            </StackPanel>
        </Border>
    </Grid>

</Window>