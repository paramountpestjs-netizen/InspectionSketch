<Window x:Class="InspectionSketch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:drawing="clr-namespace:InspectionSketch.Drawing"
        Title="Inspection Sketch"
        Width="1200"
        Height="800"
        Background="#202020"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <drawing:SketchCanvas x:Name="DrawingCanvas"
                          Grid.Column="0"
                          Background="White"
                          MouseLeftButtonDown="DrawingCanvas_MouseLeftButtonDown" />

        <Border Grid.Column="1"
            Background="#F3F3F3"
            BorderBrush="#CCCCCC"
            BorderThickness="1,0,0,0"
            Padding="15">

            <StackPanel>
                <StackPanel Orientation="Horizontal"
            Margin="0,0,0,20">

                    <Button x:Name="UndoButton"
            Content="Undo"
            Width="85"
            Height="32"
            Margin="0,0,8,0"
            Click="UndoButton_Click" />

                    <Button x:Name="RedoButton"
            Content="Redo"
            Width="85"
            Height="32"
            Click="RedoButton_Click" />

                </StackPanel>
                <TextBlock Text="Selected Wall"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="Black"
                       Margin="0,0,0,15" />

                <TextBlock Text="Length"
                       Foreground="Black"
                       FontWeight="SemiBold" />

                <TextBlock x:Name="SelectedWallLengthText"
                       Text="No wall selected"
                       Foreground="Black"
                       FontSize="16"
                       Margin="0,5,0,15" />

                <Button x:Name="EditWallLengthButton"
                       Content="Edit Length"
                       Height="32"
                       IsEnabled="False"
                       Click="EditWallLengthButton_Click" />
                
                <Button x:Name="DeleteWallButton"
                       Content="Delete Wall"
                       Height="32"
                       Margin="0,10,0,0"
                       IsEnabled="False"
                       Click="DeleteWallButton_Click" />
            </StackPanel>

        </Border>
    </Grid>

</Window>